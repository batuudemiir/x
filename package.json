{
  "name": "x-growth-mcp",
  "version": "0.1.0",
  "description": "MCP server for growing on X (Twitter): algorithm-aware tweet/reply composition, drafts, style profile, and posting via the X API free tier.",
  "type": "module",
  "bin": {
    "x-growth-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/knowledge && cp src/knowledge/*.md dist/knowledge/",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "nanoid": "^5.0.9",
    "twitter-api-v2": "^1.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
