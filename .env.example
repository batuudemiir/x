# X (Twitter) API — OAuth 1.0a user context keys from https://developer.x.com
# App permissions must be "Read and write" (regenerate tokens after changing).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Optional: where drafts/style/usage files live (default: ~/.x-growth-mcp)
# X_MCP_DATA_DIR=

# Optional: "true" to simulate posting without calling the X API
# X_MCP_DRY_RUN=true
